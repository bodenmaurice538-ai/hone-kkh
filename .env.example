# Production problem-service client (Finney NETUID 5)
# Defaults to the production V3 problem server; set only for a private or test server.
# PROBLEM_SERVER_URL=https://d344p1xue0u9qs.cloudfront.net
PROBLEM_SERVER_ALLOW_INSECURE_HTTP=false
PROBLEM_SERVER_REQUEST_TIMEOUT_S=60

# Machine-specific validator settings
# VALIDATOR_DISPATCH_CONCURRENCY=256
# Miners graded at once; each may use a full sandbox memory limit and a workspace
# copy. Unset, it is sized from the host's CPUs, memory and free disk at startup.
# VALIDATOR_GRADING_CONCURRENCY=2
# Short-lived slots for connection establishment and request upload. Requests
# waiting here are not signed yet; miner solve time does not hold a slot. Keep
# this near 32: very small values can spend too much of the response deadline.
# VALIDATOR_SEND_CONCURRENCY=32
# VALIDATOR_SCORE_STATE_FILE=data/validator_scores.json
# Defaults to v3_evaluations.jsonl beside the score file; empty disables it.
# VALIDATOR_DIAGNOSTICS_FILE=data/v3_evaluations.jsonl
# Tell a miner why it failed, sent straight to its axon after a graded round.
# Both default true. Notices carry a reason code; details add the failing
# check's command and expected output. Turn details off BEFORE any change that
# lets a task be dispatched twice; turning it off later cannot unsay what was
# already shown.
# VALIDATOR_FAILURE_NOTICES=true
# VALIDATOR_FAILED_CHECK_DETAILS=true
# Send a sample of trajectory references to the evaluation service. Off until
# both the HTTPS URL and the service hotkey are set. Rate is per submission.
# VALIDATOR_TRACE_CHECK_URL=
# VALIDATOR_TRACE_CHECK_HOTKEY=
# VALIDATOR_TRACE_CHECK_RATE=0.01

# Dispatch, scoring, cadence, and payment policy are fixed by the release.
# Pulling and restarting adopts the current policy; .env cannot override it.

# Chain identity. setup_validator.sh can populate the two wallet fields.
NETUID=5
SUBTENSOR_NETWORK=finney
WALLET_NAME=YOUR_WALLET_NAME
WALLET_HOTKEY=YOUR_WALLET_HOTKEY

# Which backend writes answers: "openrouter" (paid API client, the default) or "code_agent"
# (Claude Code run headless on a subscription, through a local capture proxy). code_agent ignores
# the OpenRouter solver/acceptance/adjudicator/audit settings below; Claude Code iterates itself.
MINER_SOLVER=openrouter

# --- code_agent backend (only when MINER_SOLVER=code_agent) ---
# The host needs: Node >=22, the `claude` CLI installed, and `claude` logged in to the subscription
# (run `claude` once and sign in, or use `claude setup-token`). ANTHROPIC_API_KEY and
# ANTHROPIC_AUTH_TOKEN MUST be unset in the miner's environment or they outrank the subscription.
# NOTE: a subscription used this way (unattended, commercial) is against Anthropic's consumer terms
# and the account can be limited; that would silence every UID at once. You accept that risk.
MINER_CODE_AGENT_MODEL=opus
# Model for terminal_script_v1 tasks; empty uses MINER_CODE_AGENT_MODEL. Aliases track the latest
# of each (sonnet = Sonnet 5.5). Terminal tasks are mechanical, so a faster model suits them.
MINER_CODE_AGENT_TERMINAL_MODEL=sonnet
MINER_CODE_AGENT_BINARY=claude
MINER_CODE_AGENT_UPSTREAM=https://api.anthropic.com
# HOME for the Claude Code child, where its saved login lives; empty inherits the miner's HOME.
MINER_CODE_AGENT_HOME=
MINER_CODE_AGENT_MAX_TURNS=80
# Per-solve client-side spend ceiling for `claude --max-budget-usd`; 0 disables it.
MINER_CODE_AGENT_BUDGET_USD=0
# Passes --dangerously-skip-permissions (Claude Code refuses it as root, so run as a service user).
MINER_CODE_AGENT_SKIP_PERMISSIONS=true

# Demo OpenRouter miner (only needed when running start_demo_miner.sh)
# Use a normal key from https://openrouter.ai/settings/keys; a management key cannot make model calls.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_MAX_TOKENS=32000
OPENROUTER_REASONING_EFFORT=high
# Model for terminal_script_v1 solves; empty uses OPENROUTER_MODEL for every task type.
MINER_TERMINAL_MODEL=
# Model for half of repository_patch_v1 solves (an A/B split by task id hash); empty disables the split.
MINER_REPOSITORY_ALT_MODEL=
OPENROUTER_REQUEST_TIMEOUT_S=900
OPENROUTER_MAX_RETRIES=2
OPENROUTER_UPLOAD_RESERVE_S=45

# The miner binds on all interfaces and advertises its externally reachable
# address through Bittensor. Leave AXON_EXTERNAL_IP empty for auto-detection.
AXON_HOST=0.0.0.0
AXON_PORT=8091
AXON_EXTERNAL_IP=
MINER_MAX_CONCURRENT_REQUESTS=4
MINER_MAX_WORKSPACE_TOOL_CALLS=80
MINER_MAX_REQUEST_BYTES=1000000
MINER_METAGRAPH_SYNC_S=300
MINER_MIN_STAKE=0
MINER_REQUIRE_VALIDATOR_PERMIT=true
# Test answers in the validators' sandbox image (needs Docker and the pinned image).
MINER_SANDBOX=true
MINER_SANDBOX_CONCURRENCY=2
# Stop and submit the work so far this long before the time limit, or past this spend.
MINER_WRAP_UP_RESERVE_S=90
MINER_MAX_SOLVE_COST_USD=1.5
# Before the review, run an acceptance suite that a second model call writes from the task's
# documentation alone (never seeing the answer), and settle its failures against the documentation.
MINER_ACCEPTANCE_SUITE=true
# How often that suite may run in one solve: again after each answer to its failures, until every case
# passes or is refuted with a word-for-word quotation of the documentation, or three quarters of the time
# has passed. 1 sends the failures back once and never reruns the suite (the behaviour before 2026-11-13).
MINER_ACCEPTANCE_RUNS=5
# Before the review, ask the model for the points where it chose a reading of the documentation and have
# a second call rule on them from the documentation alone; the reader may be a stronger model than the
# answer's (empty means the same model). Each ruling that differs goes back to be applied.
# Off since 2026-11-12: replays showed the readers' majority overruling a correct reading in 2 of 14 failures
# (one answer passed every hidden test before its rulings) and rescuing none, for about $0.33 of a $1.20 solve.
MINER_ADJUDICATOR=false
MINER_ADJUDICATOR_MODEL=anthropic/claude-opus-5.5
# Readers that rule on the same questions; the majority decides each one, a tie keeps the model's reading.
MINER_ADJUDICATOR_VOTES=3
# Before the review, run the import lines written in the task's documentation against the work (Python tasks)
# and send back the ones that fail: a missing __init__.py, re-export or module fails every hidden test.
MINER_SURFACE_CHECK=true
# On every finished Go answer, check the diff for an error type the project returns as a pointer that the
# answer returns or stores as a value (rlvr/neurons/lint.py); a finding goes back with the fix. It also turns
# the four diff questions on or off (a form encoder, a builtin subclass, a JS destructuring default, math.fsum).
MINER_LINT=true
# Before the review, import every existing Python module the answer edits as supplied and as answered, in the
# sandbox, and send back a difference: a workaround that makes a module importable without a missing compiled
# extension changes what the hidden tests see (rlvr/neurons/imports.py).
MINER_IMPORT_CHECK=true
# Before the review, parse every JavaScript source the answer touches with the project's own bundler chain in
# the sandbox (browserify's parser, Babel with the project's configuration), and send back what it newly
# rejects: syntax Node runs but the project's toolchain cannot read fails every test that loads the feature
# through the project's entry point (rlvr/neurons/toolchain.py).
MINER_TOOLCHAIN_CHECK=true
# After the final check, run the model's last few test commands again on the final version and record in
# tasks.csv whether one now breaks (rlvr/neurons/owntests.py): off, record (sends nothing) or ask (sends an
# unambiguous breakage back once; wait for about a week of records with no false alarm on a passed solve).
MINER_OWN_TESTS=record
# Before the review, match the readings the first finished reply names under a heading of its own against the
# fallback and percent-encoding rules, and quote a match back once with the input to run (adjudicate.py).
MINER_CHOICE_CHECK=true
# Before the review, a stronger model reads the finished diff against the documentation and lists concrete
# violations, which go back to be checked by running them. Off by default: live (2026-11-11, 07:57 to 14:45)
# the conservative version found nothing in 10 of 13 solves, four of them failures, and one of its two
# findings re-broke a test when applied, for about $0.20 a solve. Empty model means the same model.
MINER_AUDIT=false
MINER_AUDIT_MODEL=anthropic/claude-opus-5.5
# Below this much OpenRouter credit, solves skip the independent suite's author and the extra readers (about
# $0.35 a solve), so the credit lasts until a top-up; a task the miner cannot answer scores zero. 0 = never.
MINER_ECONOMY_BELOW_USD=15
# With several hotkeys on this host, one process each: a directory they all write, so a task reaching more
# than one of them is solved once and its answer reused (docs/DEMO_MINER.md, "Several hotkeys"). What differs
# per hotkey (WALLET_HOTKEY, AXON_PORT, MINER_RECORD_DIR, MINER_WORK_DIR) goes in a file named by MINER_ENV_FILE.
# MINER_SHARED_DIR=data/shared

# Where workspaces are unpacked. Keep this on disk: /tmp is often held in memory.
MINER_WORK_DIR=workspaces

# Each solve, each validator verdict and each trajectory, for scripts/solve_report.py.
# LOG.md and tasks.csv there list every task: passed or failed, why, its kind and its cost.
MINER_RECORD_DIR=data/solves
